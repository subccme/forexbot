# ─────────────────────────────────────────────────────────────────
# ForexBot  –  Environment Configuration
# Copy to .env and fill in your values
# NEVER commit the real .env to version control
# ─────────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────────
# Create a bot at https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── OANDA (recommended for live trading) ─────────────────────────
# Sign up at https://www.oanda.com/register/
# Get API key from: My Account > API Access
# Practice account URL: https://api-fxpractice.oanda.com/v3
# Live account URL:    https://api-fxtrade.oanda.com/v3
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_BASE_URL=https://api-fxpractice.oanda.com/v3

# ── Alpha Vantage (free tier, data-only, 5 req/min) ──────────────
# Get free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# ── Web Search API (choose one) ──────────────────────────────────
# Option A: SerpAPI — https://serpapi.com  (100 free searches/mo)
SERP_API_KEY=your_serpapi_key_here

# Option B: Google Custom Search Engine
# Setup: https://programmablesearchengine.google.com
# API key: https://console.cloud.google.com → Custom Search API
GOOGLE_CSE_KEY=your_google_cse_key_here
GOOGLE_CSE_ID=your_cse_id_here

# ── Encryption ───────────────────────────────────────────────────
# Optional: Set a fixed key so encrypted API keys survive restarts.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURITY_KEY=

# ── Storage paths ─────────────────────────────────────────────────
USER_DB_PATH=data/users.json
TRADE_LOG_PATH=data/trades.json

# ── Bot behaviour ─────────────────────────────────────────────────
MAX_OPEN_TRADES=5
SCAN_INTERVAL_MIN=10
